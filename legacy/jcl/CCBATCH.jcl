//CCBATCH  JOB (CC0001),'CONTA CORRENTE NOTURNO',CLASS=A,
//             MSGCLASS=X,NOTIFY=&SYSUID
//*--------------------------------------------------------------*
//* BATCH NOTURNO DE CONTA CORRENTE                              *
//* STEP010 - CCJUROS : ENCARGOS DIARIOS DO CHEQUE ESPECIAL      *
//* STEP020 - CCTARIF : TARIFAS MENSAIS (SO NO 1O DIA UTIL)      *
//*--------------------------------------------------------------*
//STEP010  EXEC PGM=CCJUROS
//STEPLIB  DD DSN=PRD.CC.LOADLIB,DISP=SHR
//CONTAS   DD DSN=PRD.CC.CONTAS.MESTRE,DISP=SHR
//ENCARGOS DD DSN=PRD.CC.ENCARGOS.D&DATA,DISP=(NEW,CATLG),
//            SPACE=(CYL,(50,10)),DCB=(RECFM=FB,LRECL=100)
//REJJUROS DD DSN=PRD.CC.REJJUROS.D&DATA,DISP=(NEW,CATLG),
//            SPACE=(CYL,(5,5)),DCB=(RECFM=FB,LRECL=80)
//SYSOUT   DD SYSOUT=*
//*
//STEP020  EXEC PGM=CCTARIF,COND=(4,LT,STEP010)
//STEPLIB  DD DSN=PRD.CC.LOADLIB,DISP=SHR
//CONTAS   DD DSN=PRD.CC.CONTAS.MESTRE,DISP=SHR
//MOVTOS   DD DSN=PRD.CC.MOVTOS.MENSAL,DISP=SHR
//TARIFAS  DD DSN=PRD.CC.TARIFAS.M&MES,DISP=(NEW,CATLG),
//            SPACE=(CYL,(20,10)),DCB=(RECFM=FB,LRECL=100)
//REJTARIF DD DSN=PRD.CC.REJTARIF.M&MES,DISP=(NEW,CATLG),
//            SPACE=(CYL,(5,5)),DCB=(RECFM=FB,LRECL=80)
//SYSOUT   DD SYSOUT=*
